InpFixedLots=0.01
InpRequireTrend=true
InpBurstMinSpreads=1.5
InpBurstMinFlow=0.5
InpBurstMinSpeedX=1.5
InpUsePullback=true
InpUseProfile=true
InpProfileBias=true
InpMinRoomR=0.6
InpSlAtr=1.4
InpSlMinSpreads=3.5
InpTpR=0.45
InpBreakEvenR=0.3
InpTrailStartR=0.0
InpMaxHoldSec=300
InpFlowExit=true
InpExitFlow=0.6
InpFlowExitMaxR=0.2
InpSessionStartHour=0
InpSessionEndHour=24
InpTradeWeekends=true
