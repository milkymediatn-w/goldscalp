# ---- Telegram ----
BOT_TOKEN=123456:ABC-from-BotFather
ADMIN_IDS=111111111
BRAND_NAME=GoldScalp Signals
SUPPORT_HANDLE=@your_support
PRICE_TEXT=$29 / month

# ---- Strategy preset: SCALP | SCALP1M | BALANCED | MACRO ----
PRESET=SCALP
# Any Config field can be overridden by its UPPER_CASE name, e.g.:
# SENSITIVITY=8
# SL_MULT=1.8
# TP1_MULT=1.5
# TP2_MULT=2.5
# TP3_MULT=4.0
# BE_AFTER_TP1=true
# RSI_OB=75
# RSI_OS=25
# FAST_EMA=9
# SLOW_EMA=21
# STABILITY=3

# ---- Data source: oanda | yfinance ----
# oanda = spot XAU/USD with real bid/ask spread (free practice account works).
# yfinance = GC=F gold futures, no key, fallback only.
DATA_SOURCE=yfinance

# OANDA v20: My Account -> Manage API Access -> Generate token
OANDA_TOKEN=
OANDA_ENV=practice

# MetaTrader 5 (Windows only, terminal installed and logged in on the same machine)
MT5_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_UTC_OFFSET=3    # leave blank to auto-detect

SCAN_SECONDS=30
